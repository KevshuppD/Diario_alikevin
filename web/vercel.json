{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "redirects": [
    { "source": "/normal", "destination": "/album", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/configuracion", "destination": "/configuracion.html" },
    { "source": "/config", "destination": "/config.html" },
    { "source": "/categorias", "destination": "/categorias.html" },
    { "source": "/categories", "destination": "/categories.html" },
    { "source": "/edicion", "destination": "/edicion.html" },
    { "source": "/edit", "destination": "/edit.html" },
    { "source": "/album", "destination": "/album.html" },
    { "source": "/coleccion", "destination": "/coleccion.html" },
    { "source": "/radar", "destination": "/radar.html" },
    { "source": "/db", "destination": "/db.html" },
    { "source": "/migrate", "destination": "/migrate.html" },
    { "source": "/", "destination": "/album.html" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
