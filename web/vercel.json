{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/configuracion", "destination": "/config.html" },
    { "source": "/config", "destination": "/config.html" },
    { "source": "/categorias", "destination": "/categories.html" },
    { "source": "/categories", "destination": "/categories.html" },
    { "source": "/edicion", "destination": "/edit.html" },
    { "source": "/edit", "destination": "/edit.html" },
    { "source": "/album", "destination": "/normal.html" },
    { "source": "/coleccion", "destination": "/normal.html" },
    { "source": "/normal", "destination": "/normal.html" },
    { "source": "/radar", "destination": "/radar.html" },
    { "source": "/db", "destination": "/db.html" },
    { "source": "/migrate", "destination": "/migrate.html" },
    { "source": "/", "destination": "/normal.html" }
  ]
}
