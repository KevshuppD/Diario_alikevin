{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/configuracion", "destination": "/index.html" },
    { "source": "/config", "destination": "/index.html" },
    { "source": "/categorias", "destination": "/index.html" },
    { "source": "/categories", "destination": "/index.html" },
    { "source": "/edicion", "destination": "/index.html" },
    { "source": "/edit", "destination": "/index.html" },
    { "source": "/album", "destination": "/index.html" },
    { "source": "/coleccion", "destination": "/index.html" },
    { "source": "/normal", "destination": "/index.html" },
    { "source": "/radar", "destination": "/index.html" },
    { "source": "/db", "destination": "/index.html" },
    { "source": "/migrate", "destination": "/migrate.html" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
